APP_NAME=inDriver
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=delivery_central
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
# Fija la sesión a la conexión central: cuando hay tenencia activa (login de usuarios de
# tenant), "database.default" cambia a la conexión "tenant" y esa base no tiene tabla `sessions`.
SESSION_CONNECTION=mysql
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

FRONTEND_URL=http://localhost:5173
SANCTUM_STATEFUL_DOMAINS=localhost:5173,127.0.0.1:5173

# Respaldo de push nativo (FCM, spec tenant/018): solo se usa como servicio de envío de mensajes,
# no como base de datos. Ruta al JSON de la cuenta de servicio de Firebase, descargado una vez
# desde la consola de Firebase. Sin configurar, FcmSender no manda nada (falla silenciosamente).
FIREBASE_PROJECT_ID=
FIREBASE_CREDENTIALS_PATH=

# Rutas por calles del modo TEST (spec tenant/025). Sin ella la simulacion usa linea recta.
GOOGLE_MAPS_API_KEY=
# Velocidad del movil simulado en modo TEST (spec tenant/025). 60 = realista; subela solo en
# desarrollo para no esperar el viaje completo en tiempo real.
SIMULACION_VELOCIDAD_KMH=60
SIMULACION_PASO_SEGUNDOS=2

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
# La cola siempre en la central: dentro de una petición de tenant, `database.default` apunta a la
# conexión "tenant" (Stancl), y los jobs terminarían en la base del tenant, donde ningún worker los
# busca. Los jobs que sí son de un tenant (ExpirarOfertaPedido, AvisarSinConfirmar) ya
# inicializan tenancy() ellos mismos en su handle().
DB_QUEUE_CONNECTION=mysql

CACHE_STORE=database
# Mismo motivo que DB_QUEUE_CONNECTION arriba: la tabla `cache` solo existe en la base central
# (`database/migrations/`, no en `database/migrations/tenant/`). Sin esto, cualquier
# `Cache::store(config('cache.default'))` hecho dentro de tenancy() (p. ej. FcmSender) apunta a
# `database.default`, que Stancl cambia a la conexión "tenant", y truena con "Base table or view
# not found: cache".
DB_CACHE_CONNECTION=mysql
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# Microservicio GPS (spec tenant/028). Vacio = integracion apagada: la App sigue mandando la
# posicion al endpoint de Laravel, que es el comportamiento previo a esa spec.
# GPS_SERVICE_URL es la base publica del servicio, sin barra final.
GPS_SERVICE_URL=
# Secreto con el que se firma el permiso GPS. Distinto de APP_KEY. Generar con:
#   php -r "echo bin2hex(random_bytes(32));"
GPS_TOKEN_SECRET=
# Token fijo con el que Laravel consulta conductores cercanos al servicio.
GPS_SERVICE_TOKEN=

MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
