    "tailwindcss": "^4.3.3",
    "vue": "^3.5.40",
    "vue-router": "^5.2.0"
  },
  "devDependencies": {
    "@iconify-json/flat-color-icons": "^1.2.3",
    "@iconify-json/fluent-color": "^1.2.21",
