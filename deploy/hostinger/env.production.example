# =============================================================================
# Plantilla del .env de PRODUCCIÓN
#
# Se copia a ~/domains/delivery.prosello.com.mx/backend/.env EN EL SERVIDOR y se
# rellenan los valores marcados con <...>.
#
# Los placeholders NUNCA pueden llevar espacios sin comillas: dotenv aborta la
# lectura del archivo entero con "Encountered unexpected whitespace", y el
# error que ves después no menciona el .env por ningún lado. Por eso los
# valores opcionales se dejan vacíos en vez de describirlos entre <>.
#
# Este archivo NO tiene secretos y por eso se versiona. El .env real vive solo
# en el servidor: nunca se sube a GitHub, y deploy-backend.sh lo tiene excluido
# de la subida para no pisarlo jamás.
#
# Solo se comentan las variables cuyo valor DIFIERE del entorno local.
# =============================================================================

APP_NAME=inDriver
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://delivery.prosello.com.mx

# APP_KEY se genera EN EL SERVIDOR con `php artisan key:generate`. No se copia
# la del entorno local: es la llave con la que se cifran sesiones y datos.
#
# APP_DEBUG=false no es opcional. Con true, cualquier error de PHP devuelve al
# navegador el stack completo y el volcado de variables de entorno, incluidas
# las credenciales de la base.

FRONTEND_URL=https://delivery.prosello.com.mx

# Sin "www", coherente con el host canónico que fuerza el .htaccess. Si aquí
# apareciera www, la cookie se emitiría para un host al que el 301 nunca deja
# llegar y no habría sesión posible.
SANCTUM_STATEFUL_DOMAINS=delivery.prosello.com.mx

APP_LOCALE=es
APP_FALLBACK_LOCALE=es
APP_FAKER_LOCALE=es_MX

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null

# debug llena el disco del plan compartido en cuestión de días.
LOG_LEVEL=warning

# -----------------------------------------------------------------------------
# Base de datos
#
# hPanel crea la base y el usuario con el prefijo de la cuenta (uXXXXXXXX_).
# La contraseña solo se muestra una vez, al crearla.
# -----------------------------------------------------------------------------
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=<base_de_datos>
DB_USERNAME=<usuario>
DB_PASSWORD=<contraseña>

# -----------------------------------------------------------------------------
# Sesión
# -----------------------------------------------------------------------------
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/

# null = cookie host-only: la sesión NO se comparte con ningún otro host del
# dominio, ni con los que puedan crearse en el futuro.
SESSION_DOMAIN=null

# La cookie de sesión no viaja nunca por HTTP.
SESSION_SECURE_COOKIE=true

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
CACHE_STORE=database

# database y no redis: el plan compartido no ofrece Redis. Sin colas ni workers
# la base alcanza de sobra.

# -----------------------------------------------------------------------------
# Correo saliente (SMTP de Hostinger)
#
# La cuenta se crea en hPanel > Correos. Puerto 465 con MAIL_SCHEME=smtps.
# -----------------------------------------------------------------------------
MAIL_MAILER=smtp
MAIL_SCHEME=smtps
MAIL_HOST=smtp.hostinger.com
MAIL_PORT=465
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS="no-reply@prosello.com.mx"
MAIL_FROM_NAME="${APP_NAME}"

# -----------------------------------------------------------------------------
# Mapas/GPS
#
# Reservada por specs/001-inicio-proyecto.md; no se usa todavía en ninguna
# parte del código. Viaja vacía también en producción.
# -----------------------------------------------------------------------------
GOOGLE_MAPS_API_KEY=
